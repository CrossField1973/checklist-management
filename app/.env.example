# Kopieren nach .env und anpassen. Alle Variablen siehe ../Pflichtenheft.md, Abschnitt 6.

# Pflicht
APP_BASE_URL=http://localhost:3000
# Zufälliger Wert, mind. 32 Zeichen, z. B.: openssl rand -hex 32
SESSION_SECRET=

# false = neue Nutzer können nicht erstellt werden (Registrierung, API, SSO-Auto-Anlage gesperrt)
REGISTRATION_ENABLED=true

DEFAULT_LANGUAGE=de
# Papierkorb-Aufbewahrung für neue Nutzer in Tagen (0 = nie)
TRASH_RETENTION_DAYS=30
PASSWORD_BREACH_CHECK=local
# Anfragen pro Minute und API-Token
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# Optional: Mailserver für "Passwort vergessen"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Optional: SSO (OpenID Connect)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Redirect-URI beim Anbieter eintragen: <APP_BASE_URL>/api/v1/auth/oidc/callback
# Bezeichnung auf der Anmelde-Schaltfläche und angeforderte Scopes (optional)
OIDC_NAME=SSO
OIDC_SCOPES=openid email profile
